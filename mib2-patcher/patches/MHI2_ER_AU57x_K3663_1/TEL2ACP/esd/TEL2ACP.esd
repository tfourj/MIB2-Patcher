#---------------------------------------------------------------------
# TEL2ACP - the TEL hard key opens Apple CarPlay
# Linked into /eso/hmi/engdefs by "tel2acp.sh gem-on"
# Runs from the copy on the unit (/mnt/app/eso/mib2-patcher), no SD card needed
# [x] marks the selected mode, tel2acp.sh rewrites them
# The Set_CarPlay_Custom submenu is in TEL2ACP_custom.esd, Set_CarPlay_Keys in TEL2ACP_keys.esd
#---------------------------------------------------------------------
screen   TEL2ACP MIB2_Patcher

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/status.sh"
   label    "Status"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/mode-tel.sh"
   label    "[x] Mode: TEL / CarPlay"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/mode-carplay.sh"
   label    "[ ] Mode: CarPlay only"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/mode-custom.sh"
   label    "[ ] Mode: CarPlay / CarPlay Custom"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/install.sh"
   label    "Install TEL -> CarPlay"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/uninstall.sh"
   label    "Uninstall TEL -> CarPlay"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/TEL2ACP/esd/restore.sh"
   label    "Restore original lsd.sh"
