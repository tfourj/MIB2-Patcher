#---------------------------------------------------------------------
# JOKERBTN - joker (star) button
# Linked into /eso/hmi/engdefs by "jokerbtn.sh gem-on"
# Runs from the copy on the unit (/mnt/app/eso/mib2-patcher), no SD card needed
#---------------------------------------------------------------------
screen   Joker_button JOKERBTN

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-stock.sh"
   label    "Stock (MMI joker setting)"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-prev.sh"
   label    "Previous track"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-next.sh"
   label    "Next track"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-mute.sh"
   label    "Mute"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-navinfo.sh"
   label    "Nav announcement"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-radio.sh"
   label    "Radio"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-media.sh"
   label    "Media"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-phone.sh"
   label    "Phone (TEL key)"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-nav.sh"
   label    "Navigation (NAV key)"

script
   value    sys 1 0x0100 "/net/mmx/mnt/app/eso/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/joker-menu.sh"
   label    "MENU"
