#---------------------------------------------------------------------
# JOKERBTN - voice button, short press (long press stays voice)
# Linked into /eso/hmi/engdefs by "jokerbtn.sh gem-on"
# Needs the M.I.B. SD card in the sda0 slot
#---------------------------------------------------------------------
screen   Voice_button JOKERBTN

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-stock.sh"
   label    "Stock"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-prev.sh"
   label    "Previous track"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-next.sh"
   label    "Next track"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-mute.sh"
   label    "Mute"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-navinfo.sh"
   label    "Nav announcement"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-radio.sh"
   label    "Radio"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-media.sh"
   label    "Media"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-phone.sh"
   label    "Phone (TEL key)"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-nav.sh"
   label    "Navigation (NAV key)"

script
   value    sys 1 0x0100 "/net/mmx/fs/sda0/mib2-patcher/patches/MHI2_ER_AU57x_K3663_1/JOKERBTN/esd/set/voice-menu.sh"
   label    "MENU"
